# Frontend environment configuration.
# Copy to `.env` and adjust as needed. NEVER put secrets here — this file is bundled
# into the client. Only non-sensitive, public configuration belongs in VITE_ variables.

# Base URL of the backend API. Leave as /api to use the Vite dev proxy (see vite.config.ts),
# or set to an absolute URL (e.g. https://api.campusconnect.example.com/api) in production.
VITE_API_BASE_URL=/api

# Base URL used to open the SockJS/STOMP websocket. Leave as /ws to use the dev proxy.
VITE_WS_URL=/ws

# Optional: target the dev proxy forwards to (used only by vite.config.ts during `npm run dev`).
VITE_PROXY_TARGET=http://localhost:8080
