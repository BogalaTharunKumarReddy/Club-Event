# Environment for building the MOBILE (Capacitor) app.
#
# Copy the values you need into `.env.production` (Vite loads it automatically for
# `vite build`) BEFORE running `npm run build` / `npm run cap:sync`. Unlike the web
# dev server, a packaged app has NO proxy — these MUST be absolute URLs the device
# can actually reach. Never put secrets here; this file is bundled into the client.

# --- Production (recommended): your deployed HTTPS backend --------------------
VITE_API_BASE_URL=https://api.campusconnect.example.com/api
VITE_WS_URL=https://api.campusconnect.example.com/ws

# --- Android emulator hitting a backend running on THIS machine ---------------
# 10.0.2.2 is the emulator's alias for the host loopback (localhost).
# NOTE: plain http:// requires allowing cleartext traffic on Android — see MOBILE.md.
# VITE_API_BASE_URL=http://10.0.2.2:8080/api
# VITE_WS_URL=http://10.0.2.2:8080/ws

# --- Real device on the same Wi-Fi as your dev machine ------------------------
# Replace with your computer's LAN IP (find it with ipconfig / ifconfig).
# VITE_API_BASE_URL=http://192.168.1.50:8080/api
# VITE_WS_URL=http://192.168.1.50:8080/ws
