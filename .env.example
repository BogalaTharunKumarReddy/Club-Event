# =============================================================================
# CampusConnect — root environment TEMPLATE for Docker Compose
# =============================================================================
# HOW TO USE:  cp .env.example .env   (then edit the values in .env)
#
# This template is COMMITTED, so it must contain NO real secrets — only safe
# placeholders. Put your real keys in .env (git-ignored), never here.
# Docker Compose automatically reads .env.
# =============================================================================

# ---- MySQL (docker mysql container) ----
MYSQL_DATABASE=campusconnect
# CHANGE THIS. Used as the MySQL root password AND the backend datasource password.
MYSQL_ROOT_PASSWORD=tharun1437
# Host port to expose MySQL on (for local DB tools). Container port is always 3306.
MYSQL_PORT=3306

# ---- JPA / Hibernate ----
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# ---- JWT (authentication) ----
# CHANGE THIS for any real deployment. Generate a strong one with:
#   openssl rand -base64 48
JWT_SECRET=5a7e0a1adfb96f8dd23b9e2418ed1c97bcbdc8af4871a299411ea431d59457d346e9987e9e63465aaee30c975893e12d5774479a48ed879f675fb236349acc1a
JWT_ACCESS_EXPIRATION=3600000        # 1 hour (ms)
JWT_REFRESH_EXPIRATION=604800000     # 7 days (ms)

# ---- Web / CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5173,http://localhost:3000
FRONTEND_BASE_URL=http://localhost:8081

# ---- Host port mappings ----
BACKEND_PORT=8080     # http://localhost:8080/swagger-ui.html
FRONTEND_PORT=8081    # http://localhost:8081  (the app)

# ---- Seed data ----
SEED_ENABLED=true

# ---- Mail (optional) ----
# Leave MAIL_ENABLED=false to skip real sending; notifications are logged instead.
# For Brevo the host is smtp-relay.brevo.com (NOT ssmtp-relay), port 587.
MAIL_ENABLED=false
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@campusconnect.local

# ---- Payments (gateway abstraction) ----
# 'mock' settles payments INSTANTLY on the server — great for local demos, but it
# is why "click Pay -> ticket appears" with no real charge. To take REAL payments:
#   1) set PAYMENT_PROVIDER=razorpay
#   2) fill in the Razorpay keys (test mode uses rzp_test_* keys from your
#      Razorpay dashboard: Settings -> API Keys) in your .env
# The secret key stays on the server and is never sent to the browser.
PAYMENT_PROVIDER=razorpay
PAYMENT_CURRENCY=INR
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com/v1

# ---- WhatsApp ticket delivery (abstraction; mirrors payments) ----
# 'log' only writes the message to the server log (no send). To send real WhatsApp:
#   1) set WHATSAPP_PROVIDER=twilio
#   2) TWILIO_ACCOUNT_SID must start with "AC" (Account SID, on the Console home).
#      An "SK..." value is an API Key SID, NOT the Account SID.
#   3) TWILIO_WHATSAPP_FROM is a WhatsApp sender number, e.g. the sandbox number
#      whatsapp:+14155238886 (NOT the "join ..." opt-in phrase).
WHATSAPP_PROVIDER=log
WHATSAPP_DEFAULT_COUNTRY_CODE=91
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_BASE_URL=https://api.twilio.com

# ---- AI (interface-only until a key is supplied) ----
AI_ENABLED=false
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# ---- Frontend build-time public config (compiled into the bundle — no secrets) ----
VITE_API_BASE_URL=/api
VITE_WS_URL=/ws
