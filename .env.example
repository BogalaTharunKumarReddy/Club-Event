# =============================================================================
# CampusConnect — root environment file for Docker Compose
# =============================================================================
# HOW TO USE:  cp .env.example .env   (then edit the values below)
#
# Docker Compose automatically reads this file. NEVER commit your real .env
# (it is git-ignored). The values below are DEV DEFAULTS that let the stack
# boot immediately — you MUST change the secrets before deploying anywhere real.
# =============================================================================

# ---- MySQL ----
MYSQL_DATABASE=campusconnect
# CHANGE THIS. Used as the MySQL root password AND the backend datasource password.
MYSQL_ROOT_PASSWORD=tharun1437
# Host port to expose MySQL on (for local DB tools). Container port is always 3306.
MYSQL_PORT=3306

# ---- JPA / Hibernate ----
# 'update' is convenient for dev. Use 'validate' (with migrations) in production.
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# ---- JWT (authentication) ----
# CHANGE THIS for any real deployment. Must be Base64 and decode to >= 32 bytes
# (256 bits). Generate one with:   openssl rand -base64 48
JWT_SECRET=BcQraUHV/s+MQZolSUk+iGBXqNx8uqz3R8R3rSZyTC5DeJlBU4rawIlM2NUY4XoVI+aE8TmehceKJ5F3NVUuug==
JWT_ACCESS_EXPIRATION=3600000        # 1 hour (ms)
JWT_REFRESH_EXPIRATION=604800000     # 7 days (ms)

# ---- Web / CORS ----
# Browser origin(s) allowed to call the API directly (comma-separated).
# Includes the dockerised frontend (8081) and the Vite dev server (5173).
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5173,http://localhost:3000
# Used when composing links inside outgoing emails.
FRONTEND_BASE_URL=http://localhost:8081

# ---- Host port mappings ----
BACKEND_PORT=8080     # http://localhost:8080/swagger-ui.html
FRONTEND_PORT=8081    # http://localhost:8081  (the app)

# ---- Seed data ----
# Populates realistic demo data (users, clubs, events) on first empty-DB startup.
SEED_ENABLED=true

# ---- Mail (optional) ----
# Leave MAIL_ENABLED=false to skip real sending; notifications are logged instead.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@campusconnect.local

# ---- Payments (gateway abstraction) ----
# 'mock' settles payments locally for development. Swap for a real provider
# later WITHOUT code changes; provider credentials must come from env, not code.
PAYMENT_PROVIDER=mock
PAYMENT_CURRENCY=INR

# ---- AI (interface-only until a key is supplied) ----
AI_ENABLED=false
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# ---- Frontend build-time public config (compiled into the bundle — no secrets) ----
# Same-origin defaults; nginx proxies these to the backend container.
VITE_API_BASE_URL=/api
VITE_WS_URL=/ws
# For SPLIT hosting (frontend on a CDN, API on another domain) build the frontend
# with ABSOLUTE URLs instead, e.g.:
#   VITE_API_BASE_URL=https://api.your-domain.com/api
#   VITE_WS_URL=https://api.your-domain.com/ws
# and set CORS_ALLOWED_ORIGINS above to the frontend's origin. See docs/deployment.md.
